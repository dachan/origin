{
  "compilerOptions": {
    "target": "ES2021",
    "allowJs": true,
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2021", "ES2022.Error", "dom"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
